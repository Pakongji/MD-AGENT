# 이 파일은 예시입니다. 프로젝트 루트(package.json 옆)의 .env에 실제 값을 입력하세요.
# 기존 .env가 있으면 덮어쓰지 말고 DATABASE_URL만 수정하세요.
# Supabase Dashboard > Connect > Session pooler > URI (port 5432)를 복사하세요.
# [YOUR-PASSWORD]는 Supabase 계정 비밀번호가 아닌 해당 프로젝트의 DB 비밀번호입니다.
# 비밀번호의 @, :, /, #, $, % 등은 URL 인코딩하세요. 이미 인코딩된 값은 다시 인코딩하지 마세요.
# 아래 예시 host를 추측해 만들지 말고 대시보드의 전체 URI를 사용하세요.
# Session pooler 한 개를 앱과 migration이 함께 사용합니다. DIRECT_URL은 필요하지 않습니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요. 연결 정보는 서버 전용입니다.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
AI_PROVIDER="mock"
OPENAI_API_KEY=""
# 개발 모드에는 기존 로컬 대체값이 있습니다. 실제 배포에서는 반드시 무작위 비밀값을 설정하세요.
AUTH_SECRET=""
# Render 등 신뢰하는 프록시 뒤에 배포할 때만 설정하세요. 로컬에서는 필요 없습니다.
# AUTH_TRUST_HOST="true"
