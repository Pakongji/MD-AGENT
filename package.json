{
  "name": "md-ai-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "tsx scripts/db.ts deploy",
    "db:migrate:status": "tsx scripts/db.ts status",
    "db:validate": "tsx scripts/db.ts validate",
    "test:db": "tsx --test scripts/db.test.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo:add": "tsx scripts/add-demo.ts",
    "db:setup": "tsx scripts/db.ts setup",
    "db:seed-if-empty": "tsx scripts/seed-if-empty.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/env": "16.4.5",
    "@prisma/client": "6.19.0",
    "exceljs": "4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.5",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
