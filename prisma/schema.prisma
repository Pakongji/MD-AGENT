generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("VIEWER")
  permissions  String[]  @default([])
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  decisions    TaskDecision[]
  promotionPlans PromotionPlan[]
  assignedTasks  Task[]  @relation("TaskAssignee")
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("MD")
  category  String   @default("뷰티 전체")
  createdAt DateTime @default(now())
}

model TaskGroup {
  id        String   @id @default(cuid())
  goal      String
  reason    String
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String     @default("")
  category     String
  priority     String
  dueAt        DateTime?
  dueLabel     String
  status       String     @default("대기")
  aiExecutable Boolean    @default(false)
  source       String     @default("USER_INPUT")
  reason       String     @default("")
  groupId      String?
  group        TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  requiresDecision Boolean @default(false)
  inventoryId  String?
  inventory    Inventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  decisions    TaskDecision[]
  assigneeId   String?
  assignee     Account?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([assigneeId])
}

model TaskDecision {
  id           String   @id
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId     String
  author       Account  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorName   String
  status       String   @default("DRAFT")
  outcome      String   @default("PROCEED")
  content      String   @default("")
  rationale    String   @default("")
  alternatives String   @default("")
  followUp     String   @default("")
  reviewAt     DateTime?
  quantity     Int?
  evidence     Json
  confirmedAt  DateTime?
  /** NOT_REQUIRED(승인 불필요) · PENDING(승인 대기) · APPROVED(승인) · REJECTED(반려) */
  approvalStatus  String    @default("NOT_REQUIRED")
  approverId      String?
  approverName    String    @default("")
  approvalComment String    @default("")
  approvalAt      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([approvalStatus])
}

/** 업로드한 매출 원장: 일자 × 채널 × 상품 한 줄. 일별 합계(SalesMetric)와 상품·채널 집계의 원천입니다. */
model SalesRecord {
  id          String   @id @default(cuid())
  date        DateTime
  channel     String
  productKey  String
  sku         String   @default("")
  productName String   @default("")
  productId   String?
  revenue     Int
  orders      Int      @default(0)
  quantity    Int      @default(0)
  importId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, channel, productKey])
  @@index([date])
  @@index([productId])
}

/** 엑셀 업로드 이력: 누가 언제 어떤 파일을 올려 몇 줄을 반영했는지 */
model DataImport {
  id           String    @id @default(cuid())
  kind         String
  fileName     String
  totalRows    Int
  appliedRows  Int
  skippedRows  Int
  periodStart  DateTime?
  periodEnd    DateTime?
  authorId     String
  authorName   String
  summary      Json
  createdAt    DateTime  @default(now())

  @@index([kind, createdAt])
}

model SalesMetric {
  id        String   @id @default(cuid())
  date      DateTime
  category  String
  revenue   Int
  orders    Int
  visitors  Int
  createdAt DateTime @default(now())

  @@unique([date, category])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String   @unique
  contactName  String   @default("")
  email        String   @default("")
  cc           String   @default("")
  phone        String   @default("")
  deliverTo    String   @default("")
  paymentTerms String   @default("")
  leadTimeDays Int?
  memo         String   @default("")
  brands       Brand[]
  products     SupplierProduct[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/** 공급사 품목: 거래처가 공급하는 상품(공급가·MOQ). 자사 상품과 연결하면 발주서에 공급가가 들어갑니다. */
model SupplierProduct {
  id               String   @id @default(cuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name             String
  supplierSku      String   @default("")
  category         String   @default("")
  unitCost         Int?
  moq              Int?
  leadTimeDays     Int?
  memo             String   @default("")
  linkedProductId  String?
  linkedProduct    Product? @relation(fields: [linkedProductId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([supplierId, name])
  @@index([linkedProductId])
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @unique
  status     String
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@index([supplierId])
}

model Product {
  id         String     @id @default(cuid())
  name       String     @unique
  category   String
  lifecycle  String
  revenue    Int
  salesQty   Int
  marginRate Float
  risk       String
  sku        String?    @unique
  imageUrl   String?
  price      Int?
  cost       Int?
  brandId    String
  brand      Brand      @relation(fields: [brandId], references: [id])
  inventory  Inventory?
  supplierProducts SupplierProduct[]
  createdAt  DateTime   @default(now())
}

model Inventory {
  id                  String          @id @default(cuid())
  productId           String          @unique
  product             Product         @relation(fields: [productId], references: [id])
  stockQty            Int
  dailySales           Int
  stockDays            Int
  leadTimeDays         Int
  safetyStock          Int
  expectedStockoutDate DateTime
  status               String
  recommendedOrderQty Int
  orderStatus          String          @default("미발주")
  purchaseOrders       PurchaseOrder[]
  updatedAt            DateTime        @updatedAt
  decisionTasks        Task[]
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  inventoryId     String
  inventory       Inventory @relation(fields: [inventoryId], references: [id])
  quantity        Int
  status          String
  expectedArrival DateTime
  createdAt       DateTime  @default(now())
}

model MarketKeyword {
  id          String   @id @default(cuid())
  keyword     String   @unique
  monthlyVolume Int
  yearOverYear Int
  judgment    String
  currentIndex Int
  tenWeeksChange Int
  risingSince String
  weeklySeries String
  createdAt   DateTime @default(now())
}

model MarketTrend {
  id             String   @id @default(cuid())
  title          String
  event          String
  impact         String
  recommendation String
  evidence       String
  createdAt      DateTime @default(now())
}

model Article {
  id                String            @id @default(cuid())
  publisher         String
  publishedAt       DateTime
  title             String
  summary           String
  recommendationWhy String
  saved             Boolean           @default(false)
  feedback          ArticleFeedback[]
}

model ArticleFeedback {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())
}

model Competitor {
  id        String            @id @default(cuid())
  name      String            @unique
  events    CompetitorEvent[]
  createdAt DateTime          @default(now())
}

model CompetitorEvent {
  id                 String     @id @default(cuid())
  competitorId       String
  competitor         Competitor @relation(fields: [competitorId], references: [id])
  type               String
  title              String
  detail             String
  impactEstimate     Int
  affectedSkuCount   Int
  overlapDescription String
  startAt            DateTime
  endAt              DateTime
  createdAt          DateTime   @default(now())
}

model Promotion {
  id             String   @id @default(cuid())
  name           String
  goal           String
  period         String
  targetSkus     String
  benefit        String
  budget         Int
  expectedEffect String
  collaboration  String
  deliverables   String
  rationale      String
  stage          String   @default("아이디어")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  aiPlan         PromotionPlan?
}

model WorkActivity {
  id          BigInt   @id @default(autoincrement())
  entity      String
  entityId    String
  action      String
  occurredAt  DateTime @default(now())
  snapshot    Json

  @@index([entity, entityId, occurredAt])
  @@index([occurredAt])
}

model PromotionPlan {
  id          String    @id @default(cuid())
  authorId    String
  author      Account   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  promotionId String?   @unique
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  brief       Json
  research    Json
  draft       Json?
  version     Int       @default(0)
  revisions   Json      @default("[]")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId, updatedAt])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  type        String
  startAt     DateTime
  endAt       DateTime
  status      String   @default("예정")
  sourceId    String?
  description String   @default("")
  createdAt   DateTime @default(now())
}

model CollaborationRequest {
  id          String   @id @default(cuid())
  title       String
  team        String
  owner       String
  dueAt       DateTime
  status      String
  purpose     String
  deliverable String
  reference   String
  requestText String
  createdAt   DateTime @default(now())
}

model PerformanceReport {
  id           String   @id @default(cuid())
  title        String
  period       String
  achievement  Int
  summary      String
  wins         String
  misses       String
  nextActions  String
  createdAt    DateTime @default(now())
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  type      String
  content   String
  source    String
  tags      String
  createdAt DateTime @default(now())
}

model Insight {
  id             String   @id @default(cuid())
  type           String
  title          String
  interpretation String
  impact         String
  evidence       String
  actionLabel    String
  actionTarget   String
  severity       String
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  detail    String
  read      Boolean  @default(false)
  target    String
  createdAt DateTime @default(now())
}

model AIConversation {
  id        String   @id @default(cuid())
  question  String
  answer    String
  context   String
  createdAt DateTime @default(now())
}
